{
  "name": "@dpaluy/pi-jev-compact",
  "version": "0.1.0",
  "description": "Audited, non-destructive tool-trace pruning for Pi using Jev model",
  "license": "MIT",
  "author": "David Paluy",
  "type": "module",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpaluy/pi-jev-compact.git"
  },
  "homepage": "https://github.com/dpaluy/pi-jev-compact#readme",
  "bugs": "https://github.com/dpaluy/pi-jev-compact/issues",
  "engines": { "node": ">=22.20.0" },
  "keywords": ["pi-package", "pi-extension", "context", "pruning", "compaction"],
  "pi": { "extensions": ["./src/pi/extension.ts"] },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "eval": "tsx eval/run.ts",
    "eval:compare": "tsx eval/run.ts --compare",
    "eval:replay": "tsx eval/run-replay.ts",
    "eval:session": "tsx eval/run-session.ts",
    "eval:project": "tsx eval/project.ts",
    "check": "npm run typecheck && npm test && npm run eval && npm run eval:compare && npm run eval:replay",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-agent-core": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@types/node": "^22.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
